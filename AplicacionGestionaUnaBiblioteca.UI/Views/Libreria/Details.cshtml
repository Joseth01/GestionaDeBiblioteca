@model AplicacionqueGestionaUnaBiblioteca.Model.Libro

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Libro</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.elId)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.elId)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.elNombre)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.elNombre)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.laDescripcion)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.laDescripcion)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.laFechaDePublicacion)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.laFechaDePublicacion)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.elTipo)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.elTipo)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.elEstado)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.elEstado)
        </dd>
    </dl>
    <h4>Historial de Préstamos</h4>
    @if (Model.laUltimaFechaDeDevolucion != null && Model.laUltimaFechaDeDevolucion.Any())
    {
        <ul>
            @foreach (var laFecha in Model.laUltimaFechaDeDevolucion)
            {
                <li>@laFecha</li>
            }
        </ul>
    }
    else
    {
        <p>No hay historial de préstamos.</p>
    }
</div>
<div>
    @Html.ActionLink("Edit", "Edit", new { /* id = Model.PrimaryKey */ }) |
    <a asp-action="Index">Back to List</a>
</div>
